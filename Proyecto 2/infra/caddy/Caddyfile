# Reverse proxy de SmartEgg.

{
	admin off
	# El TLS lo termina el tunel (Cloudflare, ngrok, etc.), no Caddy.
	auto_https off
}

:80 {
	encode gzip

	log {
		output stdout
		format console
	}

	# WebSocket de MQTT
	handle /mqtt {
		rewrite * /
		reverse_proxy mosquitto:9001
	}

	# API REST, Swagger y especificacion OpenAPI
	handle /api/* {
		reverse_proxy backend:5000
	}

	handle /health {
		reverse_proxy backend:5000
	}

	# Grafana
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# Todo lo demas: la SPA
	handle {
		reverse_proxy frontend:80
	}
}
