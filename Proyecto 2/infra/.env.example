# Puertos publicados hacia la maquina anfitriona
MQTT_PORT_HOST=1883
MQTT_WS_PORT_HOST=9001
MONGO_PORT_HOST=27017
# CPU sin AVX (maquina vieja o VM): MONGO_TAG=4.4
MONGO_TAG=7
BACKEND_PORT_HOST=5000
GRAFANA_PORT_HOST=3000
FRONTEND_PORT_HOST=5173
# Puerto del reverse proxy.
PUBLIC_PORT_HOST=8080

# Servidor Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Identidad del nodo (se usa en los topics: smartegg/{NODE_ID}/...)
NODE_ID=incubadora-01

# Puente del PC (plataforma.sh puente / todo)
PUENTE_SERIAL=/dev/ttyACM0
# Camara: indice (ls /dev/video*) o, mejor, ruta estable de ls /dev/v4l/by-id/ (el indice cambia entre arranques)
CAMARA=0

# Comunicacion serial con el nodo
SERIAL_ENABLED=false
SERIAL_PORT=/tmp/smartegg-serial
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1
SERIAL_AUTO_DETECT=false
SERIAL_RECONNECT_DELAY=5
# 0 = persistir todas las lecturas.
SERIAL_MIN_PERSIST_INTERVAL=0

# Broker MQTT
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=30
MQTT_CLIENT_ID=smartegg-backend
MQTT_USER=smartegg
MQTT_PASS=
# Compose traduce estas credenciales a MQTT_USERNAME/MQTT_PASSWORD del backend.
MQTT_TOPIC_PREFIX=smartegg
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30
MQTT_PUBLISH_SPLIT_SENSORS=true

# Base de datos
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=smartegg
# true = el backend no arranca si no hay base.
MONGO_REQUIRED=false
MONGO_RECONNECT_DELAY=10

# Autenticacion y roles
AUTH_ENABLED=true
# CAMBIAR: cualquiera con esta clave puede firmar tokens validos.
JWT_SECRET=cambiar-esta-clave-en-produccion
JWT_ALGORITMO=HS256
JWT_EXPIRA_HORAS=12

# Usuarios que se crean solos en el primer arranque si no existen.
AUTH_SEED_USUARIOS=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador SmartEgg
OP1_USERNAME=operador1
OP1_PASSWORD=operador1
# Debe coincidir con el id que emite el firmware en el JSON del serial.
OP1_ID_OPERADOR=OP1
OP2_USERNAME=operador2
OP2_PASSWORD=operador2
OP2_ID_OPERADOR=OP2

# Umbrales (deben coincidir con los del firmware: sensors.h)
TEMP_MIN=37.0
TEMP_MAX=38.0
HUM_MIN=50.0
HUM_MAX=65.0

# Consumo: límite de energía por ciclo en kWh (0 = sin límite). 0.01 kWh = ~10 min de foco, para la demo.
ENERGY_LIMIT_KWH_PER_CYCLE=0.01

# Reportes
REPORT_FACULTY_NAME=Facultad de Ingeniería - Escuela de Ciencias y Sistemas - USAC
REPORT_PROJECT_NAME=SmartEgg - Plataforma IoT Distribuida
REPORT_TIMEZONE_LABEL=UTC

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Datasource MQTT: NO viene con Grafana, se instala al levantar el contenedor.
GRAFANA_PLUGINS=grafana-mqtt-datasource 1.2.1,yesoreyeram-infinity-datasource 4.0.0

# Exposicion publica
PUBLIC_IP=127.0.0.1
GRAFANA_ROOT_URL=http://localhost:8080/grafana/

# Dashboard visible SIN iniciar sesion en Grafana.
GRAFANA_ANON_ENABLED=true
GRAFANA_ANON_ROLE=Viewer
# Necesario solo si el dashboard se mete en un <iframe> del frontend.
GRAFANA_ALLOW_EMBEDDING=false

# Modo nube (plataforma.sh nube): EC2 del grupo
NUBE_IP=
# Clave MQTT elegida en la EC2 (vacío = MQTT_PASS)
NUBE_MQTT_PASS=
# Llave .pem para el túnel SSH a Mongo (vacío = ~/.ssh por defecto)
NUBE_SSH_KEY=
# Frontend React publicado en S3 (vacío = Swagger de la EC2)
NUBE_FRONTEND=
