# Servidor Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Identidad del nodo (se usa en los topics: smartegg/{NODE_ID}/...)
NODE_ID=incubadora-01

# Comunicación serial con el Arduino
SERIAL_ENABLED=true
# Linux: /dev/ttyUSB0 o /dev/ttyACM0 | Windows: COM3
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=1
# Si el puerto configurado falla, prueba el resto de puertos detectados.
SERIAL_AUTO_DETECT=true
SERIAL_RECONNECT_DELAY=5
# 0 = persistir todas las lecturas.
SERIAL_MIN_PERSIST_INTERVAL=0

# Broker MQTT
MQTT_ENABLED=true
# En Docker usar el nombre del servicio del compose (p.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=30
MQTT_CLIENT_ID=smartegg-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartegg
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30
# Publica temperatura y humedad también como topics sueltos
MQTT_PUBLISH_SPLIT_SENSORS=true

# Base de datos
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=smartegg
MONGO_REQUIRED=true
MONGO_RECONNECT_DELAY=10

# Umbrales
TEMP_MIN=37.0
TEMP_MAX=38.0
HUM_MIN=50.0
HUM_MAX=65.0

# Reportes
REPORT_FACULTY_NAME=Facultad de Ingeniería - Escuela de Ciencias y Sistemas - USAC
REPORT_PROJECT_NAME=SmartEgg - Plataforma IoT Distribuida
REPORT_TIMEZONE_LABEL=UTC
