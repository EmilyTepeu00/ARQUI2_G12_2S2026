            "uid": "smartegg-api"
          },
          "type": "json",
          "parser": "backend",
          "source": "url",
          "format": "table",
          "url": "/api/historico/lote/$lote",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "codigo",
              "text": "Lote",
              "type": "string"
            },
            {
              "selector": "estado",
              "text": "Estado",
              "type": "string"
            },
            {
              "selector": "dias_incubando",
              "text": "Dias",
              "type": "number"
            },
            {
              "selector": "lecturas_totales",
              "text": "Lecturas",
              "type": "number"
            },
            {
              "selector": "temp_min",
              "text": "Temp min",
              "type": "number"
            },
            {
              "selector": "temp_prom",
