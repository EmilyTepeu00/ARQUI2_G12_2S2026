{
  "uid": "smartegg-tiempo-real",
  "title": "SmartEgg - Tiempo real",
  "description": "Tiempo real del nodo. La fila de arriba se suscribe DIRECTAMENTE al broker MQTT (push, sin refresco); la de abajo consulta la API REST sobre la base de datos para el contexto que no viaja por telemetria (alarmas y accesos recientes). El historico de temperatura y humedad NO se repite aqui: vive en el dashboard 'SmartEgg - Historico'.",
  "tags": [
    "smartegg",
    "tiempo-real"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Tiempo real desde el broker MQTT",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Temperatura en vivo (MQTT)",
      "description": "Suscripcion directa al broker. Cada punto llega por push del topic, sin refresco ni polling.",
      "datasource": {
        "type": "grafana-mqtt-datasource",
        "uid": "smartegg-mqtt"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-mqtt-datasource",
            "uid": "smartegg-mqtt"
          },
          "topic": "smartegg/$nodo/sensores/temperatura"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "unidad"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 102,
