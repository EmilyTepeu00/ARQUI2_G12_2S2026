          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 9,
        "y": 1
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Actuadores (MQTT)",
      "description": "Topic retenido: al abrir el dashboard llega el ultimo estado conocido sin esperar una publicacion nueva.",
      "datasource": {
        "type": "grafana-mqtt-datasource",
        "uid": "smartegg-mqtt"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-mqtt-datasource",
            "uid": "smartegg-mqtt"
          },
          "topic": "smartegg/$nodo/actuadores/estado"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "true": {
                  "text": "ENCENDIDO",
                  "color": "green",
                  "index": 0
                },
                "false": {
                  "text": "apagado",
                  "color": "text",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^(calefaccion|ventilacion|rotacion|puerta_abierta)$/",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
