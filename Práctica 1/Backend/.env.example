# --- Servidor Flask ---
FLASK_HOST=
FLASK_PORT=
FLASK_DEBUG=

# --- Comunicación Serial con Arduino ---
# En Windows suele ser algo como "COM3"
# En Linux/Mac suele ser algo como "/dev/ttyUSB0" o "/dev/ttyACM0"
SERIAL_PORT=
SERIAL_BAUDRATE=
SERIAL_TIMEOUT=
# Si no se encuentra el puerto configurado, el backend puede
# intentar detectar automáticamente el primer puerto disponible.
SERIAL_AUTO_DETECT=
# Reintento de conexión al puerto serial (segundos)
SERIAL_RECONNECT_DELAY=

# --- Base de datos MongoDB ---
MONGO_URI=
MONGO_DB_NAME=

# --- Umbrales del sistema (deben coincidir con el firmware) ---
TEMP_MIN=
TEMP_MAX=
HUM_MIN=
HUM_MAX=

# --- Reportes ---
REPORT_FACULTY_NAME=
REPORT_PROJECT_NAME=
